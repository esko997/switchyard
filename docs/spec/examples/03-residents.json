{
  "apiVersion": "switchyard/v1alpha3", "kind": "Bundle",
  "applications": [{
    "apiVersion": "switchyard/v1alpha3", "kind": "Application",
    "id": "test-agent-cluster", "revision": 1,
    "name": "TEST agent cluster: hub, station and four residents",
    "purpose": "Synthetic TEST deployment: a Test Hub hub with TEST_ALICE and TEST_BOB on host-c; a station with TEST_CAROL and TEST_DAVE on host-a; separate caretakers and disposable TEST_CLIENT identities. Declared schema example, not deployment evidence or an activation grant.",
    "components": [
      {"id": "hub", "native": {"kind": "systemd", "unit": "test-hub.service", "source": "test-hub-unit"}, "depends_on": ["hub-video"],
       "gates": [{"id": "g5-test-hub", "kind": "exec-start-pre", "target": "test-hub.service.d/generation-gate.conf (component hub, expects TEST_HUB_ROLE unset or hub)",
                  "covers": "Boot, manual start and Restart= of test-hub.service on Host C; refuses a role mismatch so a misconfigured env cannot start a second hub.",
                  "misses": "A Test Hub started by hand with bun src/server.ts; Restart=on-failure keeps retrying a refused start every 5 s."}]},
      {"id": "hub-video", "native": {"kind": "systemd", "unit": "resident-video.service", "source": "video-unit"},
       "gates": [{"id": "g5-video", "kind": "exec-start-pre", "target": "resident-video.service.d/generation-gate.conf (component hub-video)",
                  "covers": "Boot, manual start, Restart= and the Wants= pull-in from test-hub.service.",
                  "misses": "MediaMTX started by hand."}]},
      {"id": "station", "native": {"kind": "systemd", "unit": "test-hub.service", "source": "test-hub-unit"}, "depends_on": ["station-video"],
       "gates": [{"id": "g5-test-hub", "kind": "exec-start-pre", "target": "test-hub.service.d/generation-gate.conf (component station, expects TEST_HUB_ROLE=station)",
                  "covers": "Boot, manual start and Restart= of test-hub.service on Host A; refuses when the env file does not say station (unset means hub).",
                  "misses": "A Test Hub started by hand with bun src/server.ts; Restart=on-failure keeps retrying a refused start every 5 s."}]},
      {"id": "station-video", "native": {"kind": "systemd", "unit": "resident-video.service", "source": "video-unit"},
       "gates": [{"id": "g5-video", "kind": "exec-start-pre", "target": "resident-video.service.d/generation-gate.conf (component station-video)",
                  "covers": "Boot, manual start, Restart= and the Wants= pull-in from test-hub.service.",
                  "misses": "MediaMTX started by hand."}]},
      {"id": "test-alice", "native": {"kind": "systemd", "unit": "test-alice-run.service", "unit_type": "transient", "related_units": ["resident-client@TEST_ALICE.service"], "launcher": {"id": "resident-launcher", "command_ref": "start-run"}}, "depends_on": ["hub"],
       "gates": [
         {"id": "g1-launcher", "kind": "launcher", "target": "full-client/tools/start-run.sh, before systemd-run (being built; not in the repo yet)", "covers": "The supported start path.", "misses": "Anything that does not use the launcher."},
         {"id": "g2-session", "kind": "script", "target": "run-session.sh, after argument validation and before the SESSION_HEALTH_CHILD branch", "covers": "Every session start (launcher, hand-typed systemd-run, run-until.sh) and every health-watch.py restart, because the watchdog re-executes run-session.sh; refusal exits 12, which health-watch.py treats as terminal.", "misses": "Direct body starts; a revocation does not stop a running session."},
         {"id": "g3-body", "kind": "exec-start-pre", "target": "resident-client@.service.d/generation-gate.conf (allowlisted instance TEST_ALICE -> component test-alice)", "covers": "Direct systemctl --user start resident-client@TEST_ALICE and every path that starts this body.", "misses": "Raw test-game-launcher/Java started by hand."}
       ]},
      {"id": "test-bob", "native": {"kind": "systemd", "unit": "test-bob-run.service", "unit_type": "transient", "related_units": ["resident-client@TEST_BOB.service"], "launcher": {"id": "resident-launcher", "command_ref": "start-run"}}, "depends_on": ["hub"],
       "gates": [
         {"id": "g1-launcher", "kind": "launcher", "target": "full-client/tools/start-run.sh, before systemd-run (being built; not in the repo yet)", "covers": "The supported start path.", "misses": "Anything that does not use the launcher."},
         {"id": "g2-session", "kind": "script", "target": "run-session.sh, after argument validation and before the SESSION_HEALTH_CHILD branch", "covers": "Every session start and every health-watch.py restart; refusal exits 12 (terminal).", "misses": "Direct body starts; a revocation does not stop a running session."},
         {"id": "g3-body", "kind": "exec-start-pre", "target": "resident-client@.service.d/generation-gate.conf (allowlisted instance TEST_BOB -> component test-bob)", "covers": "Direct systemctl --user start resident-client@TEST_BOB and every path that starts this body.", "misses": "Raw test-game-launcher/Java started by hand."}
       ]},
      {"id": "test-carol", "native": {"kind": "systemd", "unit": "test-carol-run.service", "unit_type": "transient", "related_units": ["resident-client@TEST_CAROL.service"], "launcher": {"id": "resident-launcher", "command_ref": "start-run"}}, "depends_on": ["hub", "station"],
       "gates": [
         {"id": "g1-launcher", "kind": "launcher", "target": "full-client/tools/start-run.sh, before systemd-run (being built; not in the repo yet)", "covers": "The supported start path.", "misses": "Anything that does not use the launcher."},
         {"id": "g2-session", "kind": "script", "target": "run-session.sh, after argument validation and before the SESSION_HEALTH_CHILD branch", "covers": "Every session start and every health-watch.py restart; refusal exits 12 (terminal).", "misses": "Direct body starts; a revocation does not stop a running session."},
         {"id": "g3-body", "kind": "exec-start-pre", "target": "resident-client@.service.d/generation-gate.conf (allowlisted instance TEST_CAROL -> component test-carol)", "covers": "Direct systemctl --user start resident-client@TEST_CAROL and every path that starts this body.", "misses": "Raw test-game-launcher/Java started by hand."}
       ]},
      {"id": "test-dave", "native": {"kind": "systemd", "unit": "test-dave-run.service", "unit_type": "transient", "related_units": ["resident-client@TEST_DAVE.service"], "launcher": {"id": "resident-launcher", "command_ref": "start-run"}}, "depends_on": ["hub", "station"],
       "gates": [
         {"id": "g1-launcher", "kind": "launcher", "target": "full-client/tools/start-run.sh, before systemd-run (being built; not in the repo yet)", "covers": "The supported start path.", "misses": "Anything that does not use the launcher."},
         {"id": "g2-session", "kind": "script", "target": "run-session.sh, after argument validation and before the SESSION_HEALTH_CHILD branch", "covers": "Every session start and every health-watch.py restart; refusal exits 12 (terminal).", "misses": "Direct body starts; a revocation does not stop a running session."},
         {"id": "g3-body", "kind": "exec-start-pre", "target": "resident-client@.service.d/generation-gate.conf (allowlisted instance TEST_DAVE -> component test-dave)", "covers": "Direct systemctl --user start resident-client@TEST_DAVE and every path that starts this body.", "misses": "Raw test-game-launcher/Java started by hand."}
       ]},
      {"id": "hub-caretaker", "native": {"kind": "systemd", "unit": "overseer-run.service", "unit_type": "transient", "launcher": {"id": "resident-launcher", "command_ref": "start-run"}}, "depends_on": ["hub"],
       "gates": [
         {"id": "g1-launcher", "kind": "launcher", "target": "full-client/tools/start-run.sh, before systemd-run (being built; caretaker handling not yet seen)", "covers": "The supported start path.", "misses": "Anything that does not use the launcher."},
         {"id": "g4-caretaker", "kind": "script", "target": "overseer-loop.sh, at start and before each pass", "covers": "Every loop start; revocation takes effect within one interval, including the hub-only review and research jobs.", "misses": "overseer.sh, test-hub-review.py or knowledge-research.py run by hand."}
       ]},
      {"id": "station-caretaker", "native": {"kind": "systemd", "unit": "overseer-run.service", "unit_type": "transient", "launcher": {"id": "resident-launcher", "command_ref": "start-run"}}, "depends_on": ["hub"],
       "gates": [
         {"id": "g1-launcher", "kind": "launcher", "target": "full-client/tools/start-run.sh, before systemd-run (being built; caretaker handling not yet seen)", "covers": "The supported start path.", "misses": "Anything that does not use the launcher."},
         {"id": "g4-caretaker", "kind": "script", "target": "overseer-loop.sh, at start and before each pass", "covers": "Every loop start; revocation takes effect within one interval.", "misses": "overseer.sh run by hand (duplicate speech)."}
       ]},
      {"id": "hub-test-client", "native": {"kind": "systemd", "unit": "resident-client@TEST_CLIENT.service", "unit_type": "instance", "source": "client-template"},
       "gates": [{"id": "g3-body", "kind": "exec-start-pre", "target": "resident-client@.service.d/generation-gate.conf on Host C: default-deny; only explicitly admitted disposable instances (TEST_CLIENT; a one-off name only with a Switchyard-written admission) check the hub-test-client token, one game-test instance at a time",
                  "covers": "Hand-started resident-client@TEST_CLIENT, and one-off identities only when admitted, on Host C. Any instance neither allowlisted nor admitted is refused.",
                  "misses": "Does NOT stop TEST_CLIENT on both hosts at once: station-test-client is a separate component with its own valid token. Cross-host identity exclusivity needs an admission-time check (other host's game-test instance inactive and the name not online on the server). Also misses the owner playing TEST_SPECTATOR from host-d and raw test-game-launcher/Java started by hand."}]},
      {"id": "station-test-client", "native": {"kind": "systemd", "unit": "resident-client@TEST_CLIENT.service", "unit_type": "instance", "source": "client-template"},
       "gates": [{"id": "g3-body", "kind": "exec-start-pre", "target": "resident-client@.service.d/generation-gate.conf on Host A: default-deny; only explicitly admitted disposable instances check the station-test-client token, one game-test instance at a time",
                  "covers": "Hand-started resident-client@TEST_CLIENT, and one-off identities only when admitted, on Host A. Any instance neither allowlisted nor admitted is refused.",
                  "misses": "Does NOT stop TEST_CLIENT on both hosts at once (hub-test-client has its own token); needs the same admission-time identity check. Also misses TEST_SPECTATOR from host-d and raw test-game-launcher/Java started by hand."}]}
    ],
    "identities": [
      {"id": "mc-test-alice", "kind": "minecraft-user", "name": "TEST_ALICE", "holders": ["test-alice"], "description": "TEST_ALICE's Minecraft login. Offline-mode server: any LAN host can log in as TEST_ALICE."},
      {"id": "mc-test-bob", "kind": "minecraft-user", "name": "TEST_BOB", "holders": ["test-bob"], "description": "TEST_BOB's Minecraft login."},
      {"id": "mc-test-carol", "kind": "minecraft-user", "name": "TEST_CAROL", "holders": ["test-carol"], "description": "TEST_CAROL's Minecraft login."},
      {"id": "mc-test-dave", "kind": "minecraft-user", "name": "TEST_DAVE", "holders": ["test-dave"], "description": "TEST_DAVE's Minecraft login."},
      {"id": "mc-test-client", "kind": "minecraft-user", "name": "TEST_CLIENT", "holders": ["hub-test-client", "station-test-client"], "description": "Disposable test identity; game-test dir and instances/TEST_CLIENT.env on both hosts (Test Bridge 25620 on both). The schema checks exclusivity only between active placements; both placements are declared, and the two holders have separate tokens, so nothing enforces one holder today."},
      {"id": "mc-test-spectator", "kind": "minecraft-user", "name": "TEST_SPECTATOR", "holders": ["hub-test-client", "station-test-client"], "description": "The owner's spectator identity, normally played from host-d (outside this application). A test client may hold it only for an explicitly admitted one-off login, checked against the server's online list first. Residents must never perceive it; that is a body/toolserver rule, not an identity rule."},
      {"id": "thread-test-alice", "kind": "codex-thread", "name": "11111111-1111-4111-8111-111111111111", "holders": ["test-alice"], "description": "TEST_ALICE's agent runtime thread in the Host C agent-home (synthetic sessions/TEST_ALICE-health.json)."},
      {"id": "thread-test-bob", "kind": "codex-thread", "name": "22222222-2222-4222-8222-222222222222", "holders": ["test-bob"], "description": "TEST_BOB's agent runtime thread in the Host C agent-home."},
      {"id": "thread-test-carol", "kind": "codex-thread", "name": "33333333-3333-4333-8333-333333333333", "holders": ["test-carol"], "description": "TEST_CAROL's agent runtime thread in the Host A agent-home."},
      {"id": "thread-test-dave", "kind": "codex-thread", "name": "PLACEHOLDER-test-dave-fresh-thread-at-next-run", "holders": ["test-dave"], "description": "TEST_DAVE illustrates a fresh-thread transition; synthetic previous thread 44444444-4444-4444-8444-444444444444 must not be resumed."}
    ],
    "datasets": [
      {
        "id": "hub-state", "snapshot": "sqlite-backup", "verify": "manifest-and-sqlite",
        "writers": ["hub", "hub-caretaker"],
        "external_actors": [{"id": "controller-wrapup", "description": "Wrap-up scripts on Controller read test-hub.sqlite over SSH with a mode=ro URI.", "access": "read"}]
      },
      {"id": "station-state", "snapshot": "sqlite-backup", "verify": "manifest-and-sqlite", "writers": ["station"]},
      {"id": "hub-agent-home", "snapshot": "files-quiesced", "verify": "manifest-and-sqlite", "writers": ["test-alice", "test-bob", "hub-caretaker"], "readers": ["hub"]},
      {"id": "station-agent-home", "snapshot": "files-quiesced", "verify": "manifest-and-sqlite", "writers": ["test-carol", "test-dave", "station-caretaker"], "readers": ["station"]},
      {
        "id": "hub-continuity", "snapshot": "files-quiesced", "verify": "sha256-manifest",
        "writers": ["test-alice", "test-bob", "hub-caretaker"], "readers": ["hub"],
        "include": ["resident/**", "sessions/**", "calls/**", "game/**", "game-TEST_BOB/**", "overseer/*.md", "overseer/last-*.log", "overseer/speak"],
        "exclude": ["**/auth.json", "**/.Xauthority", "game-test/**"],
        "external_actors": [{"id": "controller-notes-rsync", "description": "Wrap-up rsync copies resident notes from this host into the repository on Controller.", "access": "read"}],
        "health_files": [
          {"id": "test-alice-health", "path": "sessions/TEST_ALICE-health.json", "stale_on_restore": true},
          {"id": "test-bob-health", "path": "sessions/TEST_BOB-health.json", "stale_on_restore": true}
        ]
      },
      {
        "id": "station-continuity", "snapshot": "files-quiesced", "verify": "sha256-manifest",
        "writers": ["test-carol", "test-dave", "station-caretaker"], "readers": ["station"],
        "include": ["resident/**", "sessions/**", "calls/**", "game-TEST_CAROL/**", "game-TEST_DAVE/**", "overseer/*.md", "overseer/last-*.log", "overseer/speak"],
        "exclude": ["**/auth.json", "**/.Xauthority", "game-test/**"],
        "external_actors": [{"id": "controller-notes-rsync", "description": "Wrap-up rsync copies resident notes from this host into the repository on Controller.", "access": "read"}],
        "health_files": [
          {"id": "test-carol-health", "path": "sessions/TEST_CAROL-health.json", "stale_on_restore": true},
          {"id": "test-dave-health", "path": "sessions/TEST_DAVE-health.json", "stale_on_restore": true}
        ]
      }
    ],
    "secrets": [
      {"id": "hub-dashboard-token", "kind": "file", "consumers": ["hub"], "transfer": "copy", "rotates_on_use": false,
       "locations": [
         {"id": "hub-state", "form": "value", "role": "holder", "component": "hub", "dataset": "hub-state"},
         {"id": "owner-browsers", "form": "embedded", "role": "copy", "external_dependency": "dashboard-clients"}
       ]},
      {"id": "station-dashboard-token", "kind": "file", "consumers": ["station"], "transfer": "copy", "rotates_on_use": false,
       "locations": [
         {"id": "station-state", "form": "value", "role": "holder", "component": "station", "dataset": "station-state"},
         {"id": "hub-stations-file", "form": "embedded", "role": "copy", "component": "hub", "dataset": "hub-state"}
       ]},
      {"id": "hub-observer-token", "kind": "file", "consumers": ["hub"], "transfer": "reissue", "rotates_on_use": false,
       "locations": [
         {"id": "hub-state", "form": "value", "role": "holder", "component": "hub", "dataset": "hub-state"},
         {"id": "server-config", "form": "hash", "role": "verifier", "external_dependency": "server-bridge"}
       ]},
      {"id": "hub-agent-auth", "kind": "credential", "consumers": ["test-alice", "test-bob", "hub-caretaker"], "transfer": "reissue", "rotates_on_use": "unknown",
       "locations": [{"id": "agent-home", "form": "value", "role": "holder", "component": "test-alice", "dataset": "hub-agent-home"}]},
      {"id": "station-agent-auth", "kind": "credential", "consumers": ["test-carol", "test-dave", "station-caretaker"], "transfer": "reissue", "rotates_on_use": "unknown",
       "locations": [{"id": "agent-home", "form": "value", "role": "holder", "component": "test-carol", "dataset": "station-agent-home"}]},
      {"id": "hub-env", "kind": "environment-file", "consumers": ["hub", "hub-caretaker"], "transfer": "copy", "rotates_on_use": false,
       "locations": [{"id": "env-file", "form": "value", "role": "holder", "component": "hub"}]},
      {"id": "station-env", "kind": "environment-file", "consumers": ["station", "station-caretaker"], "transfer": "copy", "rotates_on_use": false,
       "locations": [{"id": "env-file", "form": "value", "role": "holder", "component": "station"}]},
      {"id": "phone-chat-token", "kind": "credential", "consumers": ["hub", "hub-caretaker", "station-caretaker"], "transfer": "copy", "rotates_on_use": false,
       "locations": [
         {"id": "hub-env-chat-url", "form": "embedded", "role": "holder", "component": "hub"},
         {"id": "station-caretaker-chat-url", "form": "embedded", "role": "holder", "component": "station-caretaker"},
         {"id": "phone-chat-service", "form": "value", "role": "verifier", "external_dependency": "phone-chat"}
       ]},
      {"id": "hub-caretaker-env", "kind": "environment-file", "consumers": ["hub-caretaker"], "transfer": "copy", "rotates_on_use": false,
       "locations": [{"id": "env-file", "form": "value", "role": "holder", "component": "hub-caretaker"}]},
      {"id": "station-caretaker-env", "kind": "environment-file", "consumers": ["station-caretaker"], "transfer": "copy", "rotates_on_use": false,
       "locations": [{"id": "env-file", "form": "value", "role": "holder", "component": "station-caretaker"}]},
      {"id": "hub-caretaker-token", "kind": "file", "consumers": ["hub-caretaker"], "transfer": "reissue", "rotates_on_use": false,
       "locations": [
         {"id": "token-file", "form": "value", "role": "holder", "component": "hub-caretaker"},
         {"id": "hub-credentials", "form": "hash", "role": "verifier", "component": "hub", "dataset": "hub-state"}
       ]},
      {"id": "station-caretaker-token", "kind": "file", "consumers": ["station-caretaker"], "transfer": "reissue", "rotates_on_use": false,
       "locations": [
         {"id": "token-file", "form": "value", "role": "holder", "component": "station-caretaker"},
         {"id": "hub-credentials", "form": "hash", "role": "verifier", "component": "hub", "dataset": "hub-state"}
       ]},
      {"id": "test-alice-api-token", "kind": "file", "consumers": ["test-alice"], "transfer": "reissue", "rotates_on_use": false,
       "locations": [
         {"id": "token-file", "form": "value", "role": "holder", "component": "test-alice"},
         {"id": "hub-credentials", "form": "hash", "role": "verifier", "component": "hub", "dataset": "hub-state"}
       ]},
      {"id": "test-bob-api-token", "kind": "file", "consumers": ["test-bob"], "transfer": "reissue", "rotates_on_use": false,
       "locations": [
         {"id": "token-file", "form": "value", "role": "holder", "component": "test-bob"},
         {"id": "hub-credentials", "form": "hash", "role": "verifier", "component": "hub", "dataset": "hub-state"}
       ]},
      {"id": "test-carol-api-token", "kind": "file", "consumers": ["test-carol"], "transfer": "reissue", "rotates_on_use": false,
       "locations": [
         {"id": "token-file", "form": "value", "role": "holder", "component": "test-carol"},
         {"id": "hub-credentials", "form": "hash", "role": "verifier", "component": "hub", "dataset": "hub-state"}
       ]},
      {"id": "test-dave-api-token", "kind": "file", "consumers": ["test-dave"], "transfer": "reissue", "rotates_on_use": false,
       "locations": [
         {"id": "token-file", "form": "value", "role": "holder", "component": "test-dave"},
         {"id": "hub-credentials", "form": "hash", "role": "verifier", "component": "hub", "dataset": "hub-state"}
       ]},
      {"id": "test-api-token", "kind": "file", "consumers": ["station-test-client"], "transfer": "reissue", "rotates_on_use": false,
       "locations": [
         {"id": "token-file", "form": "value", "role": "holder", "component": "station-test-client"},
         {"id": "hub-credentials", "form": "hash", "role": "verifier", "component": "hub", "dataset": "hub-state"}
       ]},
      {"id": "hub-test-bridge-token", "kind": "file", "consumers": ["hub", "test-alice", "test-bob", "hub-test-client"], "transfer": "reissue", "rotates_on_use": false,
       "locations": [{"id": "token-file", "form": "value", "role": "holder", "component": "hub"}]},
      {"id": "station-test-bridge-token", "kind": "file", "consumers": ["station", "test-carol", "test-dave", "station-test-client"], "transfer": "reissue", "rotates_on_use": false,
       "locations": [{"id": "token-file", "form": "value", "role": "holder", "component": "station"}]},
      {"id": "hub-xauthority", "kind": "file", "consumers": ["test-alice", "test-bob", "hub-test-client"], "transfer": "operator-provides", "rotates_on_use": "unknown",
       "locations": [{"id": "xauthority", "form": "value", "role": "holder", "component": "test-alice"}]},
      {"id": "station-xauthority", "kind": "file", "consumers": ["test-carol", "test-dave", "station-test-client"], "transfer": "operator-provides", "rotates_on_use": "unknown",
       "locations": [{"id": "xauthority", "form": "value", "role": "holder", "component": "test-carol"}]}
    ],
    "endpoints": [
      {"id": "hub-http", "component": "hub", "protocol": "tcp", "target_port": 8770, "consumers": ["Dashboard bookmark/PWA and OBS overlay source with secret path", "Resident API callers on both hosts (TEST_HUB_URL)", "Station caretaker", "Controller wrap-up scripts"]},
      {"id": "station-http", "component": "station", "protocol": "tcp", "target_port": 8770, "consumers": ["Hub federation and Live signaling proxy (live-proxy.ts) through the stations.json secret URL"]},
      {"id": "test-alice-test-bridge", "component": "test-alice", "protocol": "tcp", "target_port": 25599, "consumers": ["TEST_ALICE toolserver", "hub Watcher and Live"]},
      {"id": "test-bob-test-bridge", "component": "test-bob", "protocol": "tcp", "target_port": 25610, "consumers": ["TEST_BOB toolserver", "hub Watcher and Live"]},
      {"id": "test-carol-test-bridge", "component": "test-carol", "protocol": "tcp", "target_port": 25600, "consumers": ["TEST_CAROL toolserver", "station Watcher and Live"]},
      {"id": "test-dave-test-bridge", "component": "test-dave", "protocol": "tcp", "target_port": 25610, "consumers": ["TEST_DAVE toolserver", "station Watcher and Live"]},
      {"id": "hub-test-test-bridge", "component": "hub-test-client", "protocol": "tcp", "target_port": 25620, "consumers": ["toolserver scripts/call.ts during tests"]},
      {"id": "station-test-test-bridge", "component": "station-test-client", "protocol": "tcp", "target_port": 25620, "consumers": ["toolserver scripts/call.ts during tests"]},
      {"id": "hub-live-rtsp", "component": "hub-video", "protocol": "tcp", "target_port": 8554, "consumers": ["hub Test Hub FFmpeg publisher", "optional loopback OBS reader"]},
      {"id": "hub-live-whep", "component": "hub-video", "protocol": "tcp", "target_port": 8889, "consumers": ["hub Test Hub WHEP proxy"]},
