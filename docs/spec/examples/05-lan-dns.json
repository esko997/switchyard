{
  "apiVersion": "switchyard/v1alpha3",
  "kind": "Bundle",
  "applications": [
    {
      "apiVersion": "switchyard/v1alpha3",
      "kind": "Application",
      "id": "coredns-lan",
      "revision": 1,
      "role": "template",
      "name": "LAN DNS (CoreDNS)",
      "purpose": "Answers the operator's LAN zone from the host registry (plus operator records), including reverse lookups, and forwards every other name to upstream resolvers with caching. Unknown names in the zone get NXDOMAIN and are never forwarded. Query logging is off; errors are logged.",
      "parameters": [
        {
          "id": "zone",
          "description": "DNS zone answered locally, for example example.test (no default).",
          "format": "dns-name"
        },
        {
          "id": "upstreams",
          "description": "Resolvers that receive every name outside the zone, space-separated.",
          "format": "ip-address-list"
        }
      ],
      "config_files": [
        {
          "id": "corefile",
          "component": "dns",
          "path": "Corefile",
          "on_change": "restart",
          "content": "# Generated by Switchyard (template coredns-lan); changed with `switchyard deploy refresh-plan`.\n# No `log` plugin: queries are not logged. No health, ready or metrics listener.\n{{zone}}:5353 {\n    errors\n    hosts /etc/coredns/hosts {\n        ttl 60\n        reload 5s\n        fallthrough\n    }\n    file /etc/coredns/zone.db {{zone}}\n}\n.:5353 {\n    errors\n    hosts /etc/coredns/hosts {\n        ttl 60\n        reload 5s\n        fallthrough\n    }\n    cache 300\n    forward . {{upstreams}}\n}\n"
        },
        {
          "id": "zone-file",
          "component": "dns",
          "path": "zone.db",
          "on_change": "restart",
          "content": "; Generated by Switchyard (template coredns-lan). Names live in the hosts file; this zone only makes\n; unknown names in {{zone}} answer NXDOMAIN with this SOA instead of being forwarded.\n$ORIGIN {{zone}}.\n@ 60 IN SOA ns.{{zone}}. hostmaster.{{zone}}. 1 7200 1800 86400 60\n@ 60 IN NS ns.{{zone}}.\n"
        },
        {
          "id": "hosts",
          "component": "dns",
          "path": "hosts",
          "on_change": "none",
          "generator": {
            "kind": "registry-hosts",
            "zone": "{{zone}}"
          }
        }
      ],
      "components": [
        {
          "id": "dns",
          "native": {
            "kind": "kube",
            "subset": "podman-pod-v2",
            "mode": "quadlet-kube",
            "manifest": {
              "apiVersion": "v1",
              "kind": "Pod",
              "metadata": {
                "name": "coredns-lan",
                "labels": {
                  "app": "coredns-lan"
                }
              },
              "spec": {
                "restartPolicy": "Always",
                "terminationGracePeriodSeconds": 10,
                "containers": [
                  {
                    "name": "coredns",
                    "image": "docker.io/coredns/coredns:1.15.0@sha256:PLACEHOLDER-resolve-at-plan",
                    "args": [
                      "-conf",
                      "/etc/coredns/Corefile"
                    ],
                    "ports": [
                      {
                        "name": "dns-udp",
                        "containerPort": 5353,
                        "protocol": "UDP"
                      },
                      {
                        "name": "dns-tcp",
                        "containerPort": 5353,
                        "protocol": "TCP"
                      }
                    ],
                    "volumeMounts": [
                      {
                        "name": "config",
                        "mountPath": "/etc/coredns",
                        "readOnly": true
                      }
                    ],
                    "securityContext": {
                      "runAsUser": 65532,
                      "runAsGroup": 65532,
                      "readOnlyRootFilesystem": true,
                      "allowPrivilegeEscalation": false,
                      "capabilities": {
                        "drop": [
                          "AUDIT_CONTROL",
                          "AUDIT_READ",
                          "AUDIT_WRITE",
                          "BLOCK_SUSPEND",
                          "BPF",
                          "CHECKPOINT_RESTORE",
                          "CHOWN",
                          "DAC_OVERRIDE",
                          "DAC_READ_SEARCH",
                          "FOWNER",
                          "FSETID",
                          "IPC_LOCK",
                          "IPC_OWNER",
                          "KILL",
                          "LEASE",
                          "LINUX_IMMUTABLE",
                          "MAC_ADMIN",
                          "MAC_OVERRIDE",
                          "MKNOD",
                          "NET_ADMIN",
                          "NET_BROADCAST",
                          "NET_RAW",
                          "PERFMON",
                          "SETFCAP",
                          "SETGID",
                          "SETPCAP",
                          "SETUID",
                          "SYSLOG",
                          "SYS_ADMIN",
                          "SYS_BOOT",
                          "SYS_CHROOT",
                          "SYS_MODULE",
                          "SYS_NICE",
                          "SYS_PACCT",
                          "SYS_PTRACE",
                          "SYS_RAWIO",
                          "SYS_RESOURCE",
                          "SYS_TIME",
                          "SYS_TTY_CONFIG",
                          "WAKE_ALARM"
                        ]
                      }
                    }
                  }
                ],
                "volumes": [
                  {
                    "name": "config",
                    "hostPath": {
                      "path": "config://dns",
                      "type": "Directory"
                    }
                  }
                ]
              }
            }
          }
        }
      ],
      "endpoints": [
        {
          "id": "dns-udp",
          "component": "dns",
          "protocol": "udp",
          "target_port": 5353,
          "consumers": [
            "Router DHCP DNS server option (set by the operator)",
            "Hosts that use this resolver directly"
          ]
        },
        {
          "id": "dns-tcp",
          "component": "dns",
          "protocol": "tcp",
          "target_port": 5353,
          "consumers": [
            "Resolvers retrying truncated answers over TCP"
          ]
        }
      ],
      "requires": [
        {
          "name": "podman"
        },
        {
          "name": "systemd"
        }
      ],
      "health_checks": [
        {
          "id": "zone-soa-udp",
          "component": "dns",
          "type": "dns",
          "endpoint": "dns-udp",
          "name": "{{zone}}",
          "record_type": "SOA",
          "timeout_seconds": 3
        },
        {
          "id": "zone-soa-tcp",
          "component": "dns",
          "type": "dns",
          "endpoint": "dns-tcp",
          "name": "{{zone}}",
          "record_type": "SOA",
          "timeout_seconds": 3
        }
      ],
      "provenance": {
        "submitted_by": "switchyard-operator",
        "source": "catalogs/templates/lan-dns.json",
        "evidence": [
          "Digest is resolved from the tag at plan time and pinned in the instance",
          "The coredns image carries file capability cap_net_bind_service=+ep: with every capability dropped (empty bounding set) exec fails with EPERM. The drop list therefore names every capability except NET_BIND_SERVICE; with allowPrivilegeEscalation false (no_new_privs) and uid 65532 the process holds no effective capability",
          "CoreDNS hosts plugin answers SERVFAIL for unknown names it is authoritative for; fallthrough to a SOA-only zone file gives NXDOMAIN without forwarding",
          "hosts plugin reload 5s picks up an atomically renamed hosts file in the read-only mounted directory"
        ]
      }
    },
