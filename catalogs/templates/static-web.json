{
  "apiVersion": "switchyard/v1alpha2",
  "kind": "Application",
  "id": "static-web",
  "revision": 1,
  "role": "template",
  "name": "Static web (nginx-unprivileged)",
  "purpose": "Rootless nginx Pod on container port 8080. The image welcome page answers the health check at /; optional read-only site content is served from /site/.",
  "components": [{
    "id": "web",
    "native": {
      "kind": "kube",
      "subset": "podman-pod-v2",
      "mode": "quadlet-kube",
      "manifest": {
        "apiVersion": "v1",
        "kind": "Pod",
        "metadata": {"name": "static-web", "labels": {"app": "static-web"}},
        "spec": {
          "restartPolicy": "Always",
          "terminationGracePeriodSeconds": 10,
          "containers": [{
            "name": "web",
            "image": "docker.io/nginxinc/nginx-unprivileged:1.28.0-alpine@sha256:PLACEHOLDER-resolve-at-plan",
            "ports": [{"name": "http", "containerPort": 8080, "protocol": "TCP"}],
            "volumeMounts": [{"name": "site", "mountPath": "/usr/share/nginx/html/site", "readOnly": true}],
            "securityContext": {
              "runAsUser": 101,
              "runAsGroup": 101,
              "allowPrivilegeEscalation": false,
              "capabilities": {"drop": ["ALL"]}
            }
          }],
          "volumes": [{"name": "site", "hostPath": {"path": "dataset://site", "type": "Directory"}}]
        }
      }
    }
  }],
  "datasets": [{
    "id": "site",
    "snapshot": "files-quiesced",
    "verify": "sha256-manifest",
    "writers": ["web"],
    "readers": ["web"]
  }],
  "endpoints": [{
    "id": "http",
    "component": "web",
    "protocol": "tcp",
    "target_port": 8080,
    "consumers": ["Browser bookmark", "Firewall rule if bound beyond loopback"]
  }],
  "requires": [{"name": "podman"}, {"name": "systemd"}],
  "health_checks": [{
    "id": "page",
    "component": "web",
    "type": "http",
    "endpoint": "http",
    "path": "/",
    "status": 200,
    "redirects": false,
    "timeout_seconds": 5
  }],
  "provenance": {
    "submitted_by": "switchyard-operator",
    "source": "catalogs/templates/static-web.json",
    "evidence": ["Digest is resolved from the tag at plan time and pinned in the instance"]
  }
}
